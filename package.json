{
  "name": "rolloutctrl",
  "version": "1.2.0",
  "description": "RolloutCtrl is an open-source, self-hosted platform for feature flags, progressive delivery, and access control.",
  "keywords": [
    "rollout control",
    "rolloutctrl",
    "feature flag",
    "flag",
    "feature toggle",
    "feature",
    "toggle",
    "rbac",
    "access control"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rolloutctrl/rolloutctrl.git"
  },
  "bugs": {
    "url": "https://github.com/rolloutctrl/rolloutctrl/issues"
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migrate:dev": "npx prisma migrate dev && npx prisma generate",
    "migrate:dev:create": "npx prisma migrate dev --create-only",
    "migrate:deploy": "npx prisma migrate deploy",
    "prisma:push": "npx prisma db push",
    "prisma:generate": "npx prisma generate",
    "prisma:studio": "npx prisma studio",
    "prisma:seed": "npx prisma db seed",
    "prisma:format": "npx prisma format",
    "prepare": "husky",
    "frontend:dev": "cd frontend && yarn dev",
    "frontend:build": "cd frontend && yarn build",
    "frontend:lint": "cd frontend && yarn lint",
    "frontend:preview": "cd frontend && yarn preview"
  },
  "lint-staged": {
    "{src,apps,libs,test}/**/*.ts": "eslint --fix"
  },
  "engines": {
    "node": ">=24.x"
  },
  "dependencies": {
    "@dicebear/core": "^9.4.2",
    "@dicebear/shapes": "^9.4.2",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@rolloutctrl/evaluator": "^1.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "imurmurhash": "^0.1.4",
    "ioredis": "^6.0.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-jwt": "^4.0.1",
    "postmark": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "forceExit": true,
    "transform": {
      "^.+\\.(t|j)s$": "@swc/jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@nestjs|@dicebear)/)"
    ],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "modules/**/*.(t|j)s",
      "common/**/*.(t|j)s",
      "!**/*.module.ts",
      "!**/*.dto.ts",
      "!**/*.types.ts",
      "!**/*.constants.ts",
      "!**/generated/**"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "statements": 0,
        "branches": 0,
        "functions": 0,
        "lines": 0
      },
      "**/modules/access/access.service.ts": {
        "statements": 80,
        "branches": 50,
        "functions": 60,
        "lines": 80
      },
      "**/modules/access/access.utils.ts": {
        "statements": 95,
        "branches": 90,
        "functions": 100,
        "lines": 95
      },
      "**/modules/auth/auth.service.ts": {
        "statements": 85,
        "branches": 60,
        "functions": 90,
        "lines": 85
      },
      "**/modules/auth/strategies/jwt.strategy.ts": {
        "statements": 95,
        "branches": 80,
        "functions": 90,
        "lines": 95
      },
      "**/modules/auth/strategies/jwt-refresh-token.strategy.ts": {
        "statements": 90,
        "branches": 80,
        "functions": 70,
        "lines": 90
      },
      "**/modules/feature-flag/feature-flag.service.ts": {
        "statements": 95,
        "branches": 75,
        "functions": 95,
        "lines": 95
      },
      "**/modules/strategy/strategy.service.ts": {
        "statements": 70,
        "branches": 50,
        "functions": 70,
        "lines": 70
      },
      "**/modules/sdk/services/sdk.service.ts": {
        "statements": 75,
        "branches": 30,
        "functions": 60,
        "lines": 80
      },
      "**/modules/sdk/guards/sdk-key.guard.ts": {
        "statements": 95,
        "branches": 90,
        "functions": 100,
        "lines": 95
      },
      "**/modules/sdk/guards/sdk-origin.guard.ts": {
        "statements": 95,
        "branches": 90,
        "functions": 100,
        "lines": 95
      },
      "**/modules/sdk/guards/sdk-server.guard.ts": {
        "statements": 95,
        "branches": 90,
        "functions": 100,
        "lines": 95
      }
    },
    "testEnvironment": "node"
  }
}
